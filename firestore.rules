rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== GLOBAL HELPERS ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    // ==================== ENTITY VALIDATION BLUEPRINTS ====================
    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'invoicePresets', 'schedulePresets', 'payrollDraft', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && isValidId(data.uid)
        && isValidOptionalString(data, 'email', 200)
        && isValidOptionalString(data, 'displayName', 150)
        && (!('invoicePresets' in data) || (data.invoicePresets is list && data.invoicePresets.size() <= 60 && (data.invoicePresets.size() == 0 || data.invoicePresets[0] is string)))
        && (!('schedulePresets' in data) || (data.schedulePresets is list && data.schedulePresets.size() <= 60 && (data.schedulePresets.size() == 0 || data.schedulePresets[0] is string)))
        && (!('payrollDraft' in data) || data.payrollDraft == null || data.payrollDraft is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInvoice(data) {
      return data.keys().hasAll(['ownerId', 'invoiceNumber', 'customerName', 'address', 'eventDate', 'downPayment', 'items', 'displayCreatedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'invoiceNumber', 'customerName', 'address', 'eventDate', 'downPayment', 'items', 'tuanHajatSignature', 'hormatKamiSignature', 'notes', 'paymentStatus', 'displayCreatedAt', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.invoiceNumber is string && data.invoiceNumber.size() >= 1 && data.invoiceNumber.size() <= 80
        && data.customerName is string && data.customerName.size() <= 200
        && data.address is string && data.address.size() <= 500
        && data.eventDate is string && data.eventDate.size() <= 60
        && (data.downPayment is int || data.downPayment is float) && data.downPayment >= 0
        && data.items is list && data.items.size() <= 100 && (data.items.size() == 0 || data.items[0] is map)
        && isValidOptionalString(data, 'tuanHajatSignature', 150000)
        && isValidOptionalString(data, 'hormatKamiSignature', 150000)
        && isValidOptionalString(data, 'notes', 1000)
        && (!('paymentStatus' in data) || data.paymentStatus == null || data.paymentStatus in ['LUNAS', 'BELUM_LUNAS', 'AUTO'])
        && data.displayCreatedAt is string && data.displayCreatedAt.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['ownerId', 'customerName', 'address', 'phone', 'orderDetails', 'setupDate', 'teardownDate', 'status', 'displayCreatedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'customerName', 'address', 'phone', 'orderDetails', 'setupDate', 'teardownDate', 'status', 'picCrew', 'notes', 'sourceInvoiceId', 'sourceInvoiceNumber', 'displayCreatedAt', 'completedAt', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.customerName is string && data.customerName.size() <= 200
        && data.address is string && data.address.size() <= 500
        && data.phone is string && data.phone.size() <= 40
        && data.orderDetails is string && data.orderDetails.size() <= 5000
        && data.setupDate is string && data.setupDate.size() <= 60
        && data.teardownDate is string && data.teardownDate.size() <= 60
        && data.status in ['AKTIF', 'SELESAI']
        && isValidOptionalString(data, 'picCrew', 300)
        && isValidOptionalString(data, 'notes', 1000)
        && isValidOptionalString(data, 'sourceInvoiceId', 128)
        && isValidOptionalString(data, 'sourceInvoiceNumber', 80)
        && isValidOptionalString(data, 'completedAt', 60)
        && data.displayCreatedAt is string && data.displayCreatedAt.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPayroll(data) {
      return data.keys().hasAll(['ownerId', 'payrollNumber', 'title', 'date', 'columns', 'rows', 'displayCreatedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'payrollNumber', 'title', 'date', 'columns', 'rows', 'preparedBySignature', 'receivedBySignature', 'notes', 'displayCreatedAt', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && isValidId(data.ownerId)
        && data.payrollNumber is string && data.payrollNumber.size() >= 1 && data.payrollNumber.size() <= 80
        && data.title is string && data.title.size() <= 200
        && data.date is string && data.date.size() <= 60
        && data.columns is list && data.columns.size() <= 30 && (data.columns.size() == 0 || data.columns[0] is map)
        && data.rows is list && data.rows.size() <= 100 && (data.rows.size() == 0 || data.rows[0] is map)
        && isValidOptionalString(data, 'preparedBySignature', 150000)
        && isValidOptionalString(data, 'receivedBySignature', 150000)
        && isValidOptionalString(data, 'notes', 1000)
        && data.displayCreatedAt is string && data.displayCreatedAt.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ==================== COLLECTION RULES ====================

    // 1. User Workspace (Profile, Presets, Payroll Draft)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserWorkspace(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['invoicePresets', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['schedulePresets', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['payrollDraft', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'invoicePresets', 'schedulePresets', 'payrollDraft', 'updatedAt'])
        );
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // 2. Invoices (Nota Pemesanan)
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(invoiceId)
        && isSignedIn()
        && isValidInvoice(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(invoiceId)
        && isSignedIn()
        && isValidInvoice(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['invoiceNumber', 'customerName', 'address', 'eventDate', 'downPayment', 'items', 'tuanHajatSignature', 'hormatKamiSignature', 'notes', 'paymentStatus', 'updatedAt'])
        );
      allow delete: if isValidId(invoiceId) && isOwner(existing().ownerId);
    }

    // 3. Schedules (Jadwal Pasang & Bongkar)
    match /schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(scheduleId)
        && isSignedIn()
        && isValidSchedule(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(scheduleId)
        && isSignedIn()
        && isValidSchedule(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'completedAt', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['customerName', 'address', 'phone', 'orderDetails', 'setupDate', 'teardownDate', 'status', 'picCrew', 'notes', 'sourceInvoiceId', 'sourceInvoiceNumber', 'completedAt', 'updatedAt'])
        );
      allow delete: if isValidId(scheduleId) && isOwner(existing().ownerId);
    }

    // 4. Payrolls (Rekap Penggajian Kru)
    match /payrolls/{payrollId} {
      allow get: if isValidId(payrollId) && isOwner(existing().ownerId);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(payrollId)
        && isSignedIn()
        && isValidPayroll(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(payrollId)
        && isSignedIn()
        && isValidPayroll(incoming())
        && isOwner(existing().ownerId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['payrollNumber', 'title', 'date', 'columns', 'rows', 'preparedBySignature', 'receivedBySignature', 'notes', 'updatedAt'])
        );
      allow delete: if isValidId(payrollId) && isOwner(existing().ownerId);
    }
  }
}
